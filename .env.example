# Database
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=shopcart_db
DB_PORT=5432
# Postgres SSL mode (disable, require, verify-ca, verify-full). Defaults to disable.
DB_SSLMODE=disable

# Schema migrations — AutoMigrate runs on boot by default. Set to false in
# production and manage schema changes with a dedicated migration tool.
AUTO_MIGRATE=true

# Auth — generate a strong random value, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_secret

# Server
PORT=8000

# CORS — comma-separated list of allowed origins (enables credentials).
# Leave empty to allow any origin without credentials.
CORS_ALLOWED_ORIGINS=

# Pricing — all default to 0 (no shipping/tax) unless set.
TAX_RATE=0
SHIPPING_FEE=0
FREE_SHIPPING_THRESHOLD=0

# Push notifications — legacy FCM server key. Push is a no-op when unset.
FCM_SERVER_KEY=

# Payment webhook — shared secret expected in the X-Webhook-Secret header.
# The webhook endpoint is disabled (503) until this is set.
WEBHOOK_SECRET=

# Expose reset/verification tokens in API responses (no email provider wired).
# Set to false in production once emails are sent instead.
EXPOSE_TOKENS=true
